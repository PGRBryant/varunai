{
  "id": null,
  "uid": "varunai-room404-session",
  "title": "Room 404 Session Metrics",
  "tags": ["varunai", "room404", "gaming"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "style": "dark",
  "panels": [
    {
      "id": 1,
      "title": "Active Players",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#00F5C4" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#C8922A", "value": null },
              { "color": "#00F5C4", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "room404_active_players",
          "legendFormat": "Active Players"
        }
      ]
    },
    {
      "id": 2,
      "title": "Floor Completions (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#C8922A" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(room404_floor_completions_total[5m])) by (floor_number)",
          "legendFormat": "Floor {{floor_number}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "AI Generation Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*p50.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00F5C4" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*p95.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C8922A" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*p99.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF3B3B" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(room404_ai_generation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(room404_ai_generation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(room404_ai_generation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "AI Generation Timeouts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#FF3B3B" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "sum"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(room404_ai_generation_timeouts_total[5m])) by (generation_type)",
          "legendFormat": "{{generation_type}}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
