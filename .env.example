# Varunai Environment Configuration
# Copy to .env.local and fill in values

# Google Gemini API
GEMINI_API_KEY=

# Verika service identity
VERIKA_SERVICE_TOKEN=

# Service URLs
MYSTWEAVER_API_URL=https://mystweaver-api.run.app
ROOM404_API_URL=https://room404-api.run.app
VERIKA_API_URL=https://verika-api.run.app
GRAFANA_URL=http://localhost:3000

# GCP
GCP_PROJECT_ID=varunai-prod

# Server
PORT=8080
NODE_ENV=development
