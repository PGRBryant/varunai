{
  "name": "@internal/telemetry",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for the Varunai ecosystem",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "scripts": {
