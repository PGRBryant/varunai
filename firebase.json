{
  "hosting": {
    "site": "varunai",
    "public": "apps/client/dist",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "varunai-api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
